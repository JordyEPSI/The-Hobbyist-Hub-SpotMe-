{% extends 'admin/base_admin.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block admin_contenu %}
    <h1>Utilisateurs</h1>

    <table class="tableau">
        <thead>
            <tr>
                <th>Pseudo</th>
                <th>Email</th>
                <th>Inscrit le</th>
                <th>Rôle</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for utilisateur in utilisateurs %}
                <tr>
                    <td>{{ utilisateur.pseudo }}</td>
                    <td>{{ utilisateur.email }}</td>
                    <td>{{ utilisateur.dateInscription|date('d/m/Y') }}</td>
                    <td>{{ utilisateur.admin ? 'Administrateur' : 'Membre' }}</td>
                    <td class="actions">
                        {% if utilisateur != app.user %}
                            <form method="post" action="{{ path('admin_utilisateur_role_admin', {id: utilisateur.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('role-admin-' ~ utilisateur.id) }}">
                                <button type="submit" class="bouton-secondaire">
                                    {{ utilisateur.admin ? 'Retirer admin' : 'Passer admin' }}
                                </button>
                            </form>
                            <form method="post" action="{{ path('admin_utilisateur_supprimer', {id: utilisateur.id}) }}"
                                  onsubmit="return confirm('Supprimer le compte de {{ utilisateur.pseudo|e('js') }} ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer-' ~ utilisateur.id) }}">
                                <button type="submit" class="bouton-danger">Supprimer</button>
                            </form>
                        {% else %}
                            <em>C'est toi</em>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5">Aucun utilisateur.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
