<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}SpotMe{% endblock %} · SpotMe</title>
        <meta name="description" content="{% block description %}SpotMe, la plateforme communautaire de musculation : programmes, séances et suivi de progression.{% endblock %}">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🏋️</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="entete">
            <a class="logo" href="{{ path('app_accueil') }}">SpotMe</a>
            <nav class="nav" aria-label="Navigation principale">
                {% set route = app.request.attributes.get('_route') ?? '' %}
                <a href="{{ path('app_exercice_liste') }}" {% if route starts with 'app_exercice' %}aria-current="page"{% endif %}>Exercices</a>
                <a href="{{ path('app_programme_liste') }}" {% if route == 'app_programme_liste' or route == 'app_programme_fiche' %}aria-current="page"{% endif %}>Programmes</a>
                {% if app.user %}
                    <a href="{{ path('app_mes_programmes') }}" {% if route in ['app_mes_programmes', 'app_programme_nouveau', 'app_programme_modifier', 'app_programme_construire'] %}aria-current="page"{% endif %}>Mes programmes</a>
                    <a href="{{ path('app_seance_liste') }}" {% if route starts with 'app_seance' %}aria-current="page"{% endif %}>Mes séances</a>
                    <a href="{{ path('app_progression') }}" {% if route starts with 'app_progression' %}aria-current="page"{% endif %}>Progression</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin_tableau_de_bord') }}">Administration</a>
                    {% endif %}
                    <span class="nav-pseudo">{{ app.user.pseudo }}</span>
                    <form method="post" action="{{ path('app_deconnexion') }}" class="form-deconnexion">
                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="lien-bouton">Déconnexion</button>
                    </form>
                {% else %}
                    <a href="{{ path('app_connexion') }}">Connexion</a>
                    <a class="bouton" href="{{ path('app_inscription') }}">Inscription</a>
                {% endif %}
            </nav>
        </header>

        <main class="contenu">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ type }}" role="status">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
