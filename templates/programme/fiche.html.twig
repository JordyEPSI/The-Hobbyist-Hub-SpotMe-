{% extends 'base.html.twig' %}

{% set niveaux = {debutant: 'Débutant', intermediaire: 'Intermédiaire', avance: 'Avancé'} %}

{% block title %}{{ programme.titre }}{% endblock %}
{% block description %}{{ programme.titre }}, programme de musculation partagé par {{ programme.utilisateur.pseudo }} sur SpotMe.{% endblock %}

{% block body %}
    <p class="fil"><a href="{{ path('app_programme_liste') }}">← Tous les programmes</a></p>

    <article class="carte">
        <header class="titre-page-actions">
            <div>
                <h1>{{ programme.titre }}</h1>
                <p class="texte-doux">
                    par {{ programme.utilisateur.pseudo }} · créé le {{ programme.dateCreation|date('d/m/Y') }}
                    {% if not programme.estPublic %} · <strong>privé</strong>{% endif %}
                </p>
            </div>
            <div class="actions">
                {% if is_granted('PROGRAMME_MODIFIER', programme) %}
                    <a class="bouton-secondaire" href="{{ path('app_programme_construire', {slug: programme.slug}) }}">Construire</a>
                    <a class="bouton-secondaire" href="{{ path('app_programme_modifier', {slug: programme.slug}) }}">Modifier</a>
                {% endif %}
                {% if is_granted('PROGRAMME_SUPPRIMER', programme) %}
                    <form method="post" action="{{ path('app_programme_supprimer', {slug: programme.slug}) }}" onsubmit="return confirm('Supprimer ce programme ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer-programme-' ~ programme.id) }}">
                        <button type="submit" class="bouton-danger">Supprimer</button>
                    </form>
                {% endif %}
            </div>
        </header>
        <ul class="badges">
            {% if programme.niveau %}<li class="badge">{{ niveaux[programme.niveau] ?? programme.niveau }}</li>{% endif %}
            {% if programme.objectif %}<li class="badge">{{ programme.objectif }}</li>{% endif %}
            {% if programme.noteMoyenne is not null %}<li class="badge badge-principal">★ {{ programme.noteMoyenne|number_format(1, ',') }} / 5</li>{% endif %}
        </ul>

        {% if programme.description %}
            <p class="description">{{ programme.description|nl2br }}</p>
        {% endif %}

        {% for jour in programme.jourProgrammes %}
            <section class="jour">
                <h2>{{ jour.nom }}</h2>
                {% if jour.exerciceProgrammes is empty %}
                    <p class="texte-doux">Repos ou jour libre.</p>
                {% else %}
                    <table class="tableau">
                        <thead>
                            <tr><th>Exercice</th><th>Séries</th><th>Répétitions</th><th>Repos</th></tr>
                        </thead>
                        <tbody>
                            {% for ligne in jour.exerciceProgrammes %}
                                <tr>
                                    <td><a href="{{ path('app_exercice_fiche', {slug: ligne.exercice.slug}) }}">{{ ligne.exercice.nom }}</a></td>
                                    <td>{{ ligne.seriesCibles }}</td>
                                    <td>{{ ligne.repsCibles }}</td>
                                    <td>{{ ligne.reposSecondes }} s</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </section>
        {% else %}
            <p class="texte-doux">Ce programme n'a pas encore de jours d'entraînement.</p>
        {% endfor %}

        {% if form_note %}
            <h2>Noter ce programme</h2>
            {{ form_start(form_note, {attr: {class: 'form-note'}}) }}
                {{ form_widget(form_note.note) }}
                <button type="submit" class="bouton-secondaire">Valider ma note</button>
            {{ form_end(form_note) }}
        {% endif %}
    </article>

    {% set commentaires = programme.commentairesVisibles %}
    <section class="carte">
        <h2>Commentaires ({{ commentaires|length }})</h2>
        {% for commentaire in commentaires %}
            <article class="commentaire">
                <p class="texte-doux"><strong>{{ commentaire.utilisateur.pseudo }}</strong> · {{ commentaire.dateCreation|date('d/m/Y') }}</p>
                <p>{{ commentaire.contenu|nl2br }}</p>
            </article>
        {% else %}
            <p class="texte-doux">Pas encore de commentaire.</p>
        {% endfor %}

        {% if form_commentaire %}
            {{ form_start(form_commentaire) }}
                {{ form_row(form_commentaire.contenu) }}
                <button type="submit" class="bouton">Publier</button>
            {{ form_end(form_commentaire) }}
        {% else %}
            <p><a href="{{ path('app_connexion') }}">Connecte-toi</a> pour commenter et noter ce programme.</p>
        {% endif %}
    </section>
{% endblock %}
